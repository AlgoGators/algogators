{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // The app came out of a Figma export; strict typing is aspirational.
    // Ratchet these up as the code is cleaned, never down.
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
