# Checks are deliberately narrow. A wall of style nits trains people to pass
# -quiet and stop reading the output; these are the ones that catch real bugs in
# an order-routing engine.
---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-slicing,
  cppcoreguidelines-pro-type-member-init,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-emplace,
  performance-*,
  readability-misleading-indentation

WarningsAsErrors: >
  bugprone-use-after-move,
  bugprone-unhandled-self-assignment,
  clang-analyzer-core.*,
  concurrency-*,
  cert-err58-cpp

HeaderFilterRegex: '(include|src)/.*\.(h|hpp)$'
FormatStyle: file
