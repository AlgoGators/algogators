{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/../.."
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Local development (Debug)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "ci-gcc13",
      "inherits": "base",
      "displayName": "CI · gcc 13 · RelWithDebInfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "gcc-13",
        "CMAKE_CXX_COMPILER": "g++-13",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Werror"
      }
    },
    {
      "name": "ci-clang18",
      "inherits": "base",
      "displayName": "CI · clang 18 · RelWithDebInfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Werror"
      }
    },
    {
      "name": "ci-msvc",
      "inherits": "base",
      "displayName": "CI · MSVC · RelWithDebInfo",
      "generator": "Visual Studio 17 2022",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "/W4 /WX /permissive-"
      }
    },
    {
      "name": "ci-asan",
      "inherits": "ci-clang18",
      "displayName": "CI · clang + AddressSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -g"
      }
    },
    {
      "name": "ci-ubsan",
      "inherits": "ci-clang18",
      "displayName": "CI · clang + UndefinedBehaviorSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=all -g"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "ci-gcc13", "configurePreset": "ci-gcc13" },
    { "name": "ci-clang18", "configurePreset": "ci-clang18" },
    { "name": "ci-msvc", "configurePreset": "ci-msvc", "configuration": "RelWithDebInfo" },
    { "name": "ci-asan", "configurePreset": "ci-asan" },
    { "name": "ci-ubsan", "configurePreset": "ci-ubsan" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 300, "noTestsAction": "error" }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "ci-gcc13", "inherits": "base", "configurePreset": "ci-gcc13" },
    { "name": "ci-clang18", "inherits": "base", "configurePreset": "ci-clang18" },
    { "name": "ci-msvc", "inherits": "base", "configurePreset": "ci-msvc", "configuration": "RelWithDebInfo" },
    { "name": "ci-asan", "inherits": "base", "configurePreset": "ci-asan" },
    { "name": "ci-ubsan", "inherits": "base", "configurePreset": "ci-ubsan" }
  ]
}
