# Copy to .env (gitignored) and fill in. Never commit real values.

# Kalshi API (read-only use in research; RSA private key file kept outside the repo)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Gmail app password for email alerts (src/trading/paper_trading_execution AlertSystem)
SMTP_APP_PASSWORD=

# Optional: where data lives (defaults to ./data)
PREDICT_NGIN_DATA=

# Optional: a slower/larger drive for rarely used data (scripts/data/storage_tier.py); unset = keep everything in data/
PREDICT_NGIN_COLD=

# Optional: News API key for the latency-arb strategy (https://newsapi.org or https://eventregistry.org)
NEWSAPI_KEY=

# ── Legacy: Polymarket live trading (whale strategy, May 2026) ────────────────
# Live order placement is DISABLED in this repo (docs/ARCHITECTURE.md D14): OrderRouter(dry_run=False)
# raises. These variables are kept only so the legacy code and scripts/setup_polymarket_keys.py still
# document what they read.
# L1: Polygon wallet private key (starts with 0x); signs orders locally.
POLYMARKET_PRIVATE_KEY=0x...
# Wallet type: 0 = EOA, 1 = POLY_PROXY, 2 = GNOSIS_SAFE, 3 = POLY_1271 (deposit wallet)
POLYMARKET_SIGNATURE_TYPE=0
# Address holding the USDC capital (EOA: your wallet; type 3: Polymarket deposit wallet address)
POLYMARKET_FUNDER_ADDRESS=0x...
# L2 API credentials (generated by scripts/setup_polymarket_keys.py)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# 137 = Polygon mainnet, 80002 = Amoy testnet
POLYMARKET_CHAIN_ID=137

# SharpAPI (sharpapi.io) odds recorder: python -m predict_ngin.capture.sharpapi
SHARPAPI_KEY=
